#!/bin/bash

set -u

# Only keep one monitor alive if the compositor is restarted.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/battery-notify.lock"
flock -n 9 || exit 0

get_battery() {
    for battery in /sys/class/power_supply/BAT*; do
        [[ -r "$battery/capacity" && -r "$battery/status" ]] || continue
        printf '%s\n' "$battery"
        return 0
    done
    return 1
}

battery=$(get_battery) || exit 0
previous_band=""

while true; do
    capacity=$(<"$battery/capacity")
    status=$(<"$battery/status")
    band="ok"

    if [[ "$status" == "Discharging" ]]; then
        if (( capacity <= 15 )); then
            band="15"
        elif (( capacity <= 20 )); then
            band="20"
        elif (( capacity <= 25 )); then
            band="25"
        elif (( capacity <= 30 )); then
            band="30"
        elif (( capacity <= 40 )); then
            band="40"
        elif (( capacity <= 50 )); then
            band="50"
        fi
    fi

    if [[ "$band" != "$previous_band" ]]; then
        case "$band" in
            50)
                notify-send -u normal -i battery-good \
                    "Battery at 50%" "Battery is at ${capacity}%."
                ;;
            40)
                notify-send -u normal -i battery-good \
                    "Battery at 40%" "Battery is at ${capacity}%."
                ;;
            30)
                notify-send -u normal -i battery-low \
                    "Battery at 30%" "Battery is at ${capacity}%."
                ;;
            25)
                notify-send -u normal -i battery-low \
                    "Battery at 25%" "Battery is at ${capacity}%."
                ;;
            20)
                notify-send -u critical -i battery-caution \
                    "Battery low" "Battery is at ${capacity}%. Connect the charger."
                ;;
            15)
                notify-send -u critical -i battery-caution \
                    "Battery very low" "Battery is at ${capacity}%. Hibernation starts at 10%."
                ;;
        esac
    fi

    previous_band="$band"
    sleep 30
done
